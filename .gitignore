# ==============================================================================
# Customer Journey Intelligence (CJI) - Master .gitignore
# Industrial Standards & Enterprise Security Policy
# ==============================================================================

# ── Secrets & Environment Configuration (Strictly Excluded) ──────────────────
.env
.env.*
*.env
*.env.local
!.env.example
!frontend/.env.example
!cji_agent/.env.example

# ── Secrets & Credentials ────────────────────────────────────────────────────
*secret*
*credential*
*.pem
*.key
*.cert
*.pfx
*.p12
api_tokens.json
data/api_tokens.json
cji_agent/data/api_tokens.json

# ── Node.js & Next.js Build Artifacts ─────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
next-env.d.ts
frontend/next-env.d.ts
*.tsbuildinfo
frontend/*.tsbuildinfo
.turbo/

# ── Python & Virtual Environments ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Testing & Code Coverage ──────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.hypothesis/
.vitest-cache/
*/.vitest-cache/
test-results/
playwright-report/

# ── Linters & Type Checkers ──────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Local Runtime Data & Databases ────────────────────────────────────────────
*.db
*.sqlite3
data/
cji_agent/data/
reports/
cji_agent/reports/
!data/.gitkeep
!reports/.gitkeep

# ── Logs & Debug Files ────────────────────────────────────────────────────────
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.tmp.*
*.tmp.txt
cji_hc.txt
front-end-listing.tmp.txt

# ── CI & Local Tool Output ────────────────────────────────────────────────────
ci/out/
/ci/out/

# ── Graphify Caches & Local Output ───────────────────────────────────────────
graphify-out/

# ── Legacy Prototypes & Throwaways ───────────────────────────────────────────
front-end/

# ── OS & IDE Metadata ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
