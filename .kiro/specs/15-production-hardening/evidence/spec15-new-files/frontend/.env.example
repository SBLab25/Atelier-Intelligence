# CJI frontend (Spec 13). Copy to .env.local and fill in. All keys are read by the Next.js server only;
# none is sent to the browser (there are no NEXT_PUBLIC_ variables).

# Base URL of cji-api (the /api/v1 backend). The browser never calls it directly.
CJI_API_BASE_URL=http://127.0.0.1:8006

# Key for the encrypted session cookie: at least 32 random characters. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CJI_SESSION_SECRET=

# Spec 15: during a key rotation, the previous CJI_SESSION_SECRET (cookies sealed with it are re-issued with the
# new key, so nobody is signed out). Remove it after 8 hours (the session lifetime).
# CJI_SESSION_SECRET_PREVIOUS=
# Spec 15: proxies in front of Next.js whose X-Forwarded-For is trusted (0 = none; 1 behind one TLS proxy).
# The client address is forwarded to the API so its sign-in limits apply per user.
# CJI_FRONTEND_TRUSTED_PROXY_HOPS=0
# Timeout of one backend request in milliseconds (default 10000).
# CJI_API_TIMEOUT_MS=10000
