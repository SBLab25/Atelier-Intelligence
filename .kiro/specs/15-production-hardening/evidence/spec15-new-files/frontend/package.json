{
  "name": "cji-frontend",
  "version": "0.13.0",
  "private": true,
  "description": "Customer Journey Intelligence web frontend (Next.js) on the /api/v1 backend. Spec 13.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "api:generate": "openapi-typescript ../cji_agent/openapi/v1.json --output src/lib/api/schema.ts",
    "api:check": "node scripts/api-check.mjs",
    "test": "npm run api:check && vitest run",
    "test:watch": "vitest",
    "bundle:scan": "node scripts/bundle-scan.mjs",
    "check:env": "node --disable-warning=ExperimentalWarning scripts/check-env.mjs",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "jose": "6.2.13",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
