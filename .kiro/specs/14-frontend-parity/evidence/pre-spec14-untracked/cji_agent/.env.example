# ─── CJI configuration ──────────────────────────────────────────────────────
# Copy this file to .env and fill in what you need. .env is gitignored — NEVER commit it.
# Process environment variables override .env. .env is never read when CJI_ENV=test.
# Check a configuration:   cji-settings check [--role collector|dashboard|launcher|mcp:<service>]
# Offline demo mode needs nothing below; only the collector needs secrets.

# ── ENVIRONMENT AND MODE ───────────────────────────────────────────────────
# development | test | production. Default: production (fails closed).
CJI_ENV=development
# demo: reads data/events.parquet | realtime: reads PostgreSQL (needs DATABASE_URL)
CJI_MODE=demo
JOURNEY_NAME=user_onboarding

# ── DATABASE (PostgreSQL / Supabase) ───────────────────────────────────────
# Required by the collector, and by realtime mode. No default.
# SUPABASE_DATABASE_URL is used when DATABASE_URL is unset; postgres:// is accepted.
# Percent-encode special characters in the password.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# SUPABASE_DATABASE_URL=

# ── RUNTIME HOME AND STORAGE ────────────────────────────────────────────────
# CJI_HOME: directory for data/, reports/, .env and snippets (Spec 11). Default: the working directory.
# Set it in the environment, not here: this .env file is itself read from CJI_HOME.
# Relative CJI_DATA_DIR / CJI_REPORTS_DIR values are resolved against CJI_HOME.
# CJI_DATA_DIR=data
# CJI_REPORTS_DIR=reports

# ── SERVICES ───────────────────────────────────────────────────────────────
# Registry defaults: journey-data 8001, friction-engine 8002, insight 8003, report 8004,
# ingestion-intelligence 8005 (MCP over SSE); collector 8000; backend api 8006; dashboard 8501; frontend 3000.
# Bind/connect host for local services:
# CJI_SERVICE_HOST=127.0.0.1
# Per service: CJI_<SERVICE>_PORT, or CJI_<SERVICE>_URL for a service running elsewhere.
# <SERVICE> = JOURNEY_DATA, FRICTION_ENGINE, INSIGHT, REPORT, INGESTION_INTELLIGENCE,
#             COLLECTOR, API, DASHBOARD, FRONTEND
# CJI_REPORT_PORT=8004
# Collector URL used by the CLI and the snippet generator (https in production):
# CJI_COLLECTOR_URL=https://collector.example.com
# COLLECTOR_HOST and COLLECTOR_PORT still work but are deprecated.
# MCP client timeouts (seconds):
# CJI_MCP_CONNECT_TIMEOUT_S=5
# CJI_MCP_READ_TIMEOUT_S=300

# ── LLM PROVIDERS ──────────────────────────────────────────────────────────
# Without a key (or with CJI_LLM_PROVIDER=none) the pipeline uses rule-based fallback insights.
# One provider for everything; it is never switched automatically: groq | anthropic | none
CJI_LLM_PROVIDER=groq
# Default per provider: groq openai/gpt-oss-120b, anthropic claude-sonnet-4-6
# LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY is accepted but not used by the current code.
# CJI_LLM_TIMEOUT_S=30
# CJI_LLM_RETRY_ATTEMPTS=3
# CJI_LLM_RETRY_MIN_S=2
# CJI_LLM_RETRY_MAX_S=10
# Limit for one LLM call including retries, and calls per minute per server process:
# CJI_LLM_DEADLINE_S=90
# CJI_LLM_RATE_PER_MIN=30
# Per analysis run (beyond them the rule-based fallback is used):
# CJI_LLM_RUN_MAX_CALLS=20
# CJI_LLM_RUN_MAX_TOKENS=50000
# A cost cap needs prices (USD per million tokens); CJI has no built-in prices:
# CJI_LLM_RUN_MAX_COST_USD=
# CJI_LLM_PRICE_INPUT_PER_MTOK=
# CJI_LLM_PRICE_OUTPUT_PER_MTOK=
# One MCP tool call from a worker (seconds), and gateway audit files ("off" disables):
# CJI_MCP_CALL_TIMEOUT_S=150
# CJI_AUDIT_DIR=

# Workflow (Spec 09): checkpoints after every worker; resume with python main.py --resume --thread-id <id>
# CJI_CHECKPOINTS_DB=data/cji_checkpoints.db
# CJI_WORKFLOW_STEP_TIMEOUT_S=900      # one attempt of one step; above CJI_MCP_CALL_TIMEOUT_S
# CJI_WORKFLOW_STEP_ATTEMPTS=2         # transient errors only
# CJI_WORKFLOW_RETRY_BACKOFF_S=5

# ── BUDGETS AND THRESHOLDS ─────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=20
FRICTION_SCORE_THRESHOLD=60
REALTIME_WINDOW_MINUTES=60
REALTIME_AUTO_RUN_INTERVAL=0
# Dashboard "run analysis" subprocess limit (seconds):
# CJI_PIPELINE_TIMEOUT_S=180
# INGESTION_SAMPLE_ROWS=30
# INGESTION_CONFIDENCE_THRESHOLD=0.80

# ── COLLECTOR SECURITY ─────────────────────────────────────────────────────
# Outside CJI_ENV=development the collector will not start without a random admin key
# of at least 32 characters and an explicit origin list. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CJI_ADMIN_KEY=
# Browser origins allowed to call the collector: comma-separated, no "*", no trailing slash.
# Leave empty in development to allow the local dashboard and frontend origins.
CJI_CORS_ORIGINS=
# Optional outbound keep-alive ping; off unless set:
# CJI_KEEPALIVE_URL=https://collector.example.com/health
# CJI_KEEPALIVE_INTERVAL_S=300
# Collector limits (defaults shown). Rate limits are per minute and per process.
# CJI_COLLECTOR_MAX_BODY_BYTES=262144
# CJI_COLLECTOR_RATE_PER_KEY=120
# CJI_COLLECTOR_RATE_PER_IP=300
# CJI_COLLECTOR_ADMIN_RATE_PER_IP=10
# Number of trusted proxies in front of the collector; 0 ignores X-Forwarded-For:
# CJI_COLLECTOR_TRUSTED_PROXY_HOPS=0

# ── BACKEND API (/api/v1, cji-api) ──────────────────────────────────────────
# Tokens are created with `cji-api-token create`; the file stores only their SHA-256 hashes.
# CJI_API_TOKENS_FILE=data/api_tokens.json
# Rate limits per minute and per process:
# CJI_API_RATE_PER_TOKEN=120
# CJI_API_RATE_PER_IP=60
# Browser origins (comma-separated, https outside development; development default: localhost:3000):
# CJI_API_CORS_ORIGINS=https://app.example.com
# HMAC key for page cursors, 32+ characters, required outside development and test:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CJI_API_CURSOR_SECRET=

# ── OBSERVABILITY (LangSmith) ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cji-poc
