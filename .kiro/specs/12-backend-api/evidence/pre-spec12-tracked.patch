-# ── TrackerEvent ───────────────────────────────────────────────────────────────
-class TrackerEvent(BaseModel):
-    """
-    A single browser event sent from tracker.js.
-
-    Validation enforced:
-      - event_id: minimum 8 characters (UUIDs from tracker.js are 36+ chars)
-      - event_type: must be in ALLOWED_EVENT_TYPES
-      - duration_ms: must be >= 0
-      - url: query parameters and fragments stripped (PII prevention)
-      - metadata: accepts dict or JSON string; invalid JSON → empty dict
-    """
-
-    event_id:    str = Field(..., min_length=8, description="Unique event identifier")
-    user_id:     str = Field(..., min_length=4, description="Anonymous user UUID")
-    session_id:  str = Field(..., min_length=4, description="Per-tab session UUID")
-    journey_id:  str = Field(..., min_length=1, description="Journey being tracked")
-    step_id:     str = Field(..., min_length=1, description="Step within journey")
-    event_type:  str = Field(..., description="Must be in ALLOWED_EVENT_TYPES")
-    timestamp:   str = Field(..., min_length=1, description="ISO-8601 UTC timestamp")
-    duration_ms: int = Field(default=0, ge=0, description="Event duration in milliseconds")
-    url:         str = Field(default="", description="Sanitised page URL (no query/fragment)")
-    metadata:    dict[str, Any] = Field(default_factory=dict, description="Event-specific data")
-
-    model_config = {"extra": "ignore"}  # silently drop unknown fields from tracker.js
-
-    @field_validator("event_type")
-    @classmethod
-    def validate_event_type(cls, v: str) -> str:
-        if v not in ALLOWED_EVENT_TYPES:
-            raise ValueError(
-                f"Unknown event_type '{v}'. "
-                f"Allowed: {sorted(ALLOWED_EVENT_TYPES)}"
-            )
-        return v
-
-    @field_validator("url")
-    @classmethod
-    def sanitise_url(cls, v: str) -> str:
-        """Strip query parameters and fragment to prevent PII leakage."""
-        if not v:
-            return v
-        try:
-            parsed = urlparse(v)
-            # Reconstruct with scheme + netloc + path only (no query, no fragment)
-            sanitised = parsed._replace(query="", fragment="").geturl()
-            # Remove trailing ? or # if urlparse left them
-            return sanitised.rstrip("?").rstrip("#")
-        except Exception:
-            return ""
-
-    @field_validator("metadata", mode="before")
-    @classmethod
-    def coerce_metadata(cls, v: Any) -> dict:
-        """Accept dict or JSON string; invalid JSON → empty dict."""
-        if isinstance(v, dict):
-            return v
-        if isinstance(v, str):
-            try:
-                result = json.loads(v)
-                return result if isinstance(result, dict) else {}
-            except (json.JSONDecodeError, ValueError):
-                return {}
-        return {}
