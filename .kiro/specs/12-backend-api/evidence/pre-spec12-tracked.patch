-def ingest_file(
-    input_path: Path,
-    output_path: Path = EVENTS_PARQUET,
-    col_map: dict[str, str] | None = None,
-    root_key: str | None = None,
-    chunk_size: int = 100_000,
-    append: bool = False,
-) -> tuple[Path, int]:
-    """
-    Convert any supported event file → events.parquet.
-
-    Returns (output_path, total_rows_written).
-    """
-    col_map     = col_map or {}
-    output_path = Path(output_path)
-    output_path.parent.mkdir(parents=True, exist_ok=True)
-
-    logger.info(f"[ingest] Input:  {input_path}")
-    logger.info(f"[ingest] Output: {output_path}")
-
-    rows:   list[dict] = []
-    chunks: list[pd.DataFrame] = []
-    total  = 0
-
-    for row in _detect_and_yield(input_path, col_map, root_key):
-        rows.append(row)
-        if len(rows) >= chunk_size:
-            df_c = _finalise(pd.DataFrame(rows))
-            chunks.append(df_c)
-            total += len(df_c)
-            logger.info(f"  processed {total:,} rows so far...")
-            rows = []
-
-    if rows:
-        df_c = _finalise(pd.DataFrame(rows))
-        chunks.append(df_c)
-        total += len(df_c)
-
-    if not chunks:
-        raise ValueError(
-            "No records could be extracted from the file.\n"
-            "Check that the file is valid JSON/CSV and contains records.\n"
-            f"Inspected: {input_path}"
-        )
-
-    df_final = pd.concat(chunks, ignore_index=True)
-
-    engine = create_engine(DATABASE_URL)
-    
-    if append:
-        try:
-            df_existing_ids = pd.read_sql("SELECT event_id FROM tracking_events", engine)
-            df_final = df_final[~df_final['event_id'].isin(df_existing_ids['event_id'])]
-        except Exception:
-            pass # Table might not exist yet
-            
-        total = len(df_final)
-        logger.info(f"[ingest] Merged -> {total:,} unique new events to append")
-
-    # Safe to use replace/append because df_final was just cleaned
-    df_final.to_sql("tracking_events", engine, if_exists="append" if append else "replace", index=False)
-    
-    logger.info(f"[ingest] Wrote {total:,} rows -> postgres 'tracking_events'")
-    return output_path, total
